# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
# Local dev (SQLite, zero setup):
DATABASE_URL="file:./dev.db"
# Production (Postgres) example — see README "Going to production":
# DATABASE_URL="postgresql://user:password@host:5432/ahm_tms?sslmode=require"

# --- Sessions ---
# Random string, 32+ characters. Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-value"

# --- Seed script (first Owner account) ---
OWNER_EMAIL="owner@alhamzameridian.com"
OWNER_PASSWORD="ChangeMe!12345"

# --- Email / SMS 2FA delivery ---
# Leave both unset for local dev — OTP codes print to the server console
# instead of being sent. Set these only once a real provider is wired into
# src/lib/notify.ts (see README "Wiring real email & SMS").
# EMAIL_PROVIDER="sendgrid"
# SENDGRID_API_KEY=""
# SMS_PROVIDER="twilio"
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""
